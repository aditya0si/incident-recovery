# Copy to .env and replace every placeholder with locally generated values.
# .env is gitignored. Never commit real secrets.

POSTGRES_USER=incident
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=incident_recovery

# Collision-free loopback-only host ports (verified free at creation time).
POSTGRES_PORT=15432
GATEWAY_PORT=18080
CONTROL_PORT=18081
API_PORT=18082
CONSOLE_PORT=18083

# Credential for the internal switch listener. Required, never logged.
INTERNAL_TOKEN=replace-with-local-internal-token

# Operator bearer token for control-API writes. Required, never logged.
OPERATOR_TOKEN=replace-with-local-operator-token

# Explicit browser origin allowlist for write requests (comma separated).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Bounded investigation runtime model (Task 4) ---------------------------
# Separate from all coding-CLI credentials; never read from OpenCode/Hermes.
# Leave blank to fail closed: the worker escalates rather than substituting a
# scripted adapter. Point these at any OpenAI-compatible chat-completions API.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=20
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=800

# --- Staging provider eligibility and accounting (Task 2) --------------------
# Blocked by default. Enabling the Go non-coding runtime requires reviewed,
# scoped eligibility evidence in the JSON file named below (secure orchestrator
# configuration); a user's account authorization is not provider permission.
# Absent configuration -> blocked, and no live call is made.
OPENCODE_GO_RUNTIME_ELIGIBILITY=
# Staging-scoped durable paid-call ledger (never a module-global counter).
STAGING_PROVIDER_LEDGER=staging/.state/provider_budget.json

# Server-enforced maxima: configured values may be lower but never higher.
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_MAX_SECONDS=120
INVESTIGATION_LEASE_SECONDS=180

# Explicit opt-in only. Set to `scripted` solely for tests / the labeled demo
# override (compose.investigation.yaml). Never set in a live deployment.
INVESTIGATION_ADAPTER=


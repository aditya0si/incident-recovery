# Staging runtime configuration TEMPLATE. Copy to staging/.env (gitignored) or,
# preferably, generate it with:
#
#   uv run python scripts/staging_env.py
#
# Every secret below is deliberately a placeholder and is REJECTED by
# scripts/staging_env.py until replaced with a generated value. None of these
# may reuse the upstream tenant-api-platform development credentials
# (postgres/postgres, app_rw/app_rw) or the running incident-recovery demo.

STAGING_OWNER_USER=staging_owner
STAGING_OWNER_PASSWORD=replace-with-generated-owner-password
STAGING_DB=tenant_platform_staging

# The application role name is fixed by migration 0001 (app_rw); its password is
# generated and applied after migrations by the app-role-provision service.
STAGING_APP_USER=app_rw
STAGING_APP_PASSWORD=replace-with-generated-app-password

STAGING_REDIS_PASSWORD=replace-with-generated-redis-password
STAGING_JWT_SECRET=replace-with-generated-jwt-secret-64-hex

# Pinned tenant-api-platform source (short SHA of a6f715aac1d4e...).
STAGING_SOURCE_SHORT_SHA=a6f715a

# Loopback-only host ports, probed for availability before use. 18090 is the
# reviewed preferred port; 18092 is the staging API, 18091 the worker metrics,
# 18093 the reserved console.
STAGING_GATEWAY_PORT=18090
STAGING_WORKER_PORT=18091
STAGING_API_PORT=18092
STAGING_CONSOLE_PORT=18093
